# ===========================================
# Forma - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----- Core -----
DATABASE_URL="postgresql://user:password@localhost:5432/forma"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# ----- Server -----
SERVER_IP=""                          # VPS IP for custom domain verification
NEXT_PUBLIC_SERVER_IP=""              # Same IP, exposed to client
NEXT_PUBLIC_APP_DOMAIN="yourdomain.com"  # Your app's domain (used in middleware, SEO, etc.)

# ----- OAuth Providers (optional — enable one or both) -----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ----- Stripe (optional — for subscriptions and form payments) -----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""

# ----- Email via Resend (optional — for automations, broadcasts, notifications) -----
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Forma <notifications@yourdomain.com>"

# ----- Premium entitlements -----
SIGNUP_PREMIUM_ENABLED="false"
SIGNUP_PREMIUM_DURATION_DAYS="7"

# ----- AI usage controls -----
AI_DAILY_LIMIT_PER_USER="25"
AI_DAILY_LIMIT_PER_IP="75"

# ----- AWS S3 (optional — for file uploads) -----
AWS_S3_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ----- reCAPTCHA v3 (optional — hosted forms and signup spam protection) -----
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# ----- Cron (for processing scheduled emails and entitlement events) -----
CRON_SECRET=""  # Generate with: openssl rand -hex 16

# ----- Integration secrets (required in production) -----
# Master key for AES-256-GCM encryption of integration configs at rest
# (Slack webhook URLs, Notion/Airtable/HubSpot API keys, Google OAuth
# refresh tokens, etc.). Rotating this key will make every existing
# integration unreadable — treat it like a root credential.
# Generate with: openssl rand -hex 32
INTEGRATION_SECRET_KEY=""
